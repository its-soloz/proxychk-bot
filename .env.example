# ── Telegram Proxy Checker Bot — Environment Configuration ──
# Copy this file to .env (for local runs) or set these as environment
# variables in the Render dashboard.

# REQUIRED — get this from @BotFather
BOT_TOKEN=

# REQUIRED — the group where live proxies are forwarded (numeric, usually negative)
GROUP_ID=-1004358364327

# REQUIRED — the admin user id (has access to the admin panel)
ADMIN_ID=5010778910

# ── Lifetime working proxies + daily logs ──
# Local SQLite path. Use a mounted persistent-disk path on Render if available.
LIFETIME_DB_PATH=lifetime_proxies.sqlite3
# Daily lifetime recheck at 9:00 PM Delhi time
DAILY_LOG_HOUR=21
DAILY_LOG_MINUTE=0
DAILY_LOG_TIMEZONE=Asia/Kolkata

# ── Keep-alive (Render free tier anti-sleep) ──
# The public URL of your Render service, e.g. https://my-bot.onrender.com
# Used by the internal self-pinger. Leave blank to disable self-ping.
RENDER_EXTERNAL_URL=
# Port the health web server binds to. Render sets PORT automatically.
PORT=10000
# Seconds between internal keep-alive self-pings (Render sleeps after ~15 min idle)
KEEPALIVE_INTERVAL=480

# ── Checker tuning ──
# Total budget for each protocol attempt
CHECK_TIMEOUT=7
# Fast-fail budgets for connection setup and stalled response reads
CONNECT_TIMEOUT=3
READ_TIMEOUT=4
# Separate budget for the lightweight second request used to detect rotation
ROTATION_TIMEOUT=3
# Max concurrent proxy checks (no user cooldown; this only bounds sockets)
MAX_CONCURRENCY=300
# One user's batch cannot consume every shared check slot, so others start too
BATCH_CONCURRENCY=150
# Number of top proxies to highlight per category
TOP_N=10
